# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API Key (agent goal parsing always uses OpenAI)
# OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key

# Spend policy defaults (used when the user has no valid spend mandate)
DEFAULT_SPEND_CAP=1500
DEFAULT_AUTO_APPROVE=0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Zepto MCP Runner path (auto-detected if skills installed globally)
# ZEPTO_MCP_RUNNER=/path/to/scripts/zepto-mcp-runner.mjs

# Swiggy MCP Runner path (bundled at backend/scripts/swiggy-mcp-runner.mjs)
# SWIGGY_MCP_RUNNER=/path/to/backend/scripts/swiggy-mcp-runner.mjs
